# ── Discord app (Developer Portal → your app) ─────────────────────────────
# Bot → Reset Token. SECRET — never commit or share it.
DISCORD_TOKEN=

# General Information → Application ID (public)
CLIENT_ID=1558698425762193408

# General Information → Public Key (public). Used to verify requests to /api/interactions.
PUBLIC_KEY=770b2066e4b89df3cdd8c6c378f720088cd10487c3564e4441de64a4391783b7

# OAuth2 → Client Secret. SECRET. Only needed for Linked Roles.
CLIENT_SECRET=

# Optional: a server ID to register commands instantly while testing.
# Leave empty to register globally (can take up to ~1 hour to appear).
GUILD_ID=

# ── Web server (Interactions endpoint, Linked Roles, Terms, Privacy) ─────
# The public HTTPS address where this bot is reachable, no trailing slash.
# Leave empty on Railway/Render: it's detected automatically.
# Locally: your tunnel URL, e.g. https://xyz.trycloudflare.com
PUBLIC_URL=

# Port to listen on (default 3000). Don't set this on Railway/Render.
# PORT=3000

# Set to false to skip registering slash commands on every startup.
# REGISTER_COMMANDS=true

# Shown on the Terms of Service and Privacy Policy pages
BOT_NAME=Gatekeeper
OPERATOR_NAME=
CONTACT_EMAIL=

# Where config + records are saved (default: ./data).
# Leave empty on Railway: the attached volume is used automatically.
DATA_DIR=
